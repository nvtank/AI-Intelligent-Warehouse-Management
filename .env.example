# Chỉ dùng cho môi trường mô phỏng local. Đổi mật khẩu trước khi chạy.
POSTGRES_DB=mapflow
POSTGRES_USER=mapflow
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://mapflow:replace-with-a-local-password@localhost:55432/mapflow
API_PORT=8000
WEB_PORT=5173
# Đây là URL trình duyệt truy cập; không dùng hostname Docker "api".
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
